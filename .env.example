# =============================================================================
# EaseBrain — Master Environment Template
# =============================================================================
# Copy this file and rename it:
#   Local backend development  →  backend-ease-brain/.env
#   Local frontend development →  frontend-ease-brain/.env.local
#   Render deployment          →  paste each section into the Render dashboard
#                                 Environment Variables panel
#
# Never commit files with real secrets to the repository.
# =============================================================================


# =============================================================================
# BACKEND — Flask / SQLAlchemy
# =============================================================================

FLASK_APP=app.py
FLASK_ENV=development        # change to "production" on Render

# --- Database ---
# Render injects DATABASE_URL automatically from the linked PostgreSQL service.
# For local dev use SQLite or a local Postgres URL.
DATABASE_URL=sqlite:///easebrain.db
SQLALCHEMY_TRACK_MODIFICATIONS=false

# --- Security keys (REQUIRED in production) ---
# Generate both with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-value
JWT_SECRET_KEY=replace-with-a-different-strong-random-value

# --- JWT settings ---
JWT_ACCESS_TOKEN_EXPIRES=86400   # seconds (24 h)
JWT_TOKEN_LOCATION=headers
JWT_HEADER_NAME=Authorization
JWT_HEADER_TYPE=Bearer
JWT_COOKIE_SECURE=false          # set to true in production
JWT_COOKIE_CSRF_PROTECT=true

# --- CORS ---
# In production, set this to your frontend origin.
FRONTEND_URL=http://localhost:5173

# --- Session ---
SESSION_COOKIE_SECURE=false      # set to true in production
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict
PERMANENT_SESSION_LIFETIME=86400

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
SENDER_EMAIL=noreply@easebrain.live
MOCK_EMAIL_MODE=true             # set to false in production to send real emails
ALLOW_UNVERIFIED_SENDER=false

# --- Email verification base URL (used in verification links) ---
VERIFY_BASE_URL=http://localhost:5173

# --- Gunicorn (Render production) ---
WEB_CONCURRENCY=4

# --- Optional: LLM-based danger detection ---
DANGER_DETECTOR_LLM_ENABLED=false
DANGER_DETECTOR_LLM_PROVIDER=openai      # openai | anthropic | local
DANGER_DETECTOR_LLM_MODEL=gpt-3.5-turbo
DANGER_DETECTOR_LLM_API_KEY=
DANGER_DETECTOR_LLM_TIMEOUT=5

# --- Logging & audit ---
LOG_LEVEL=info
AUDIT_LOGGING_ENABLED=true

# --- CSRF ---
CSRF_ENABLED=true

# --- Port (Render sets this automatically; override locally if needed) ---
# PORT=5500


# =============================================================================
# FRONTEND — Vite / React
# (prefix with VITE_ so Vite exposes them to the browser bundle)
# =============================================================================

VITE_BASE_URL=http://localhost:5500/api
VITE_DEBUG=false
NODE_ENV=development
