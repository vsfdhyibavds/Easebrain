#!/bin/bash
# Sourced via BASH_ENV for every non-interactive bash invocation on Render.
# Ensures Python dependencies are correctly installed so that the start command works,
# even when Render auto-detects and runs the wrong build command (e.g. pip install instead of poetry install).

REPO_ROOT="/opt/render/project/src"

# Ensure the Render venv is on PATH (it may not be activated under BASH_ENV).
# Render creates the venv at /opt/render/venv/ for env: python services.
if [ -d "/opt/render/venv/bin" ]; then
    export PATH="/opt/render/venv/bin:$PATH"
fi

# Also add user-local bin (pip --user installs here when not in a venv)
export PATH="${HOME}/.local/bin:${PATH}"

# Resolve the Python executable (handles python / python3)
if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    exit 0
fi

# When pyproject.toml exists, the project uses Poetry. Ensure Poetry dependencies
# are installed so that gunicorn binary is on PATH.
if [ -f "${REPO_ROOT}/backend-ease-brain/pyproject.toml" ]; then
    if ! command -v gunicorn >/dev/null 2>&1; then
        echo "==> .render-bashrc: gunicorn not on PATH, running poetry install..."
        cd "${REPO_ROOT}/backend-ease-brain" && ${PY} -m pip install --upgrade pip && ${PY} -m pip install poetry && poetry install
        # Re-add bin dirs to PATH after fresh install
        if [ -d "/opt/render/venv/bin" ]; then
            export PATH="/opt/render/venv/bin:$PATH"
        fi
        export PATH="${HOME}/.local/bin:${PATH}"
    fi
# Fallback: no Poetry, use requirements.txt
elif ! command -v gunicorn >/dev/null 2>&1; then
    echo "==> .render-bashrc: gunicorn not on PATH, installing dependencies..."
    ${PY} -m pip install --upgrade pip
    ${PY} -m pip install -r "${REPO_ROOT}/backend-ease-brain/requirements.txt"
    # Re-add bin dirs to PATH after fresh install
    if [ -d "/opt/render/venv/bin" ]; then
        export PATH="/opt/render/venv/bin:$PATH"
    fi
    export PATH="${HOME}/.local/bin:${PATH}"
fi
